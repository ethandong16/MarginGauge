{
  "name": "margingauge-etsy-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "preview:pages": "wrangler pages dev dist",
    "verify:static": "node scripts/verify-static-site.mjs",
    "verify:launch": "node scripts/verify-launch-readiness.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "check": "npm run test && npm run typecheck && npm run build && npm run verify:static"
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0"
  }
}
